# Copier en .env (jamais commité).

# --- Environnement cible (staging uniquement: le harnais refuse tout autre domaine) ---
QA_DOMAIN=staging.mairie360-eip.fr

# --- Boîte de test réelle. Les comptes du seed et ceux créés par l'agent utilisent des alias
#     vous+qa-…@domaine, tous livrés ici. ---
QA_MAILBOX=
# Clé Resend en accès complet (lecture des e-mails envoyés par staging)
RESEND_API_KEY=

# --- Seed (hors agent): compte admin de base et mot de passe commun des comptes de seed ---
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_SEED_PASSWORD=
# Front dont l'hôte relaie /bff/admin/* (seed uniquement; l'agent n'appelle jamais d'API)
QA_API_FRONT=admin

# --- Observation en lecture seule (scripts/port-forward.sh) ---
QA_DB_HOST=127.0.0.1
QA_DB_PORT=55432
QA_DB_NAME=mairie_db_staging
QA_DB_USER=qa_readonly
QA_DB_PASSWORD=
QA_REDIS_HOST=127.0.0.1
QA_REDIS_PORT=55379
QA_REDIS_USERNAME=admin
QA_REDIS_PASSWORD=

# --- Cluster (port-forward) ---
QA_KUBE_CONTEXT=staging
QA_NAMESPACE=mairie360-staging
QA_RELEASE=staging

# Nombre maximal d'actions par session (garde-fou de coût)
QA_MAX_ACTIONS=150
