# Copier en .env.staging (jamais commité). Secrets et réglages de l'environnement STAGING.
# Le domaine, la base (mairie_db_staging) et les ports locaux viennent du profil du code; ne les redéfinir que pour déroger.

# Compte admin de base et mot de passe commun des comptes de seed (min. 8 caractères)
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_SEED_PASSWORD=
# Front dont l'hôte relaie /bff/admin/* (seed uniquement; l'agent n'appelle jamais d'API)
QA_API_FRONT=admin

# Observation en lecture seule (./scripts/port-forward.sh staging) — facultative
QA_DB_PASSWORD=
QA_REDIS_PASSWORD=
# Contexte kubectl si différent de « staging »
# QA_KUBE_CONTEXT=staging
