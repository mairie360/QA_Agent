# Copié en local/.env par `npm run local:init` (jamais commité). Tout est optionnel sauf JWT_SECRET (généré par init).

# Domaine local. *.localtest.me pointe vers 127.0.0.1 par le DNS public: rien à modifier dans /etc/hosts.
# Les cookies de session sont posés sur ce domaine (".mairie360.localtest.me") et partagés entre les fronts.
LOCAL_DOMAIN=mairie360.localtest.me

# Secret des jetons (≥ 32 octets, non trivial: les APIs refusent un secret faible). Généré par init.
JWT_SECRET=

# Base: valeurs fixes pour la machine de développement.
DB_NAME=mairie_db_local
DB_PASSWORD=password
DB_ROLE_PASSWORD=password
DB_PUBLISHED_PORT=57432
REDIS_PUBLISHED_PORT=57379
MAILPIT_PUBLISHED_PORT=58025

# Ports d'entrée (443 recommandé: sinon les URL des fronts doivent porter le port)
HTTP_PORT=80
HTTPS_PORT=443
# Réseau Docker de la stack (sert aussi à TRUST_PROXY des BFF)
STACK_SUBNET=172.28.40.0/24

# Limitation de débit des routes de connexion (désactivée en local)
RATE_LIMIT_ENABLED=false

# Profil optionnel « storage » (MinIO) pour les pièces jointes e-learning — images à vérifier
# MINIO_IMAGE=
# MC_IMAGE=
